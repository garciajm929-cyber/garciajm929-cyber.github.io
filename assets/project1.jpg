<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="800" height="400" fill="#0A0A0A"/>
  
  <!-- Gold accent gradient -->
  <defs>
    <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#D4AF37;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#F4D03F;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Design elements -->
  <rect x="50" y="50" width="200" height="300" fill="#1A1A1A" rx="8"/>
  <rect x="270" y="50" width="480" height="140" fill="#1A1A1A" rx="8"/>
  <rect x="270" y="210" width="230" height="140" fill="#1A1A1A" rx="8"/>
  <rect x="520" y="210" width="230" height="140" fill="#1A1A1A" rx="8"/>
  
  <!-- Gold accents -->
  <rect x="50" y="50" width="200" height="60" fill="url(#goldGradient)" rx="8"/>
  <line x1="290" y1="80" x2="530" y2="80" stroke="#D4AF37" stroke-width="4"/>
  <circle cx="320" cy="280" r="30" fill="url(#goldGradient)"/>
  <circle cx="570" cy="280" r="30" fill="url(#goldGradient)"/>
  
  <!-- Text -->
  <text x="150" y="90" font-family="Arial" font-size="24" font-weight="bold" fill="#FFFFFF" text-anchor="middle">Student</text>
  <text x="400" y="130" font-family="Arial" font-size="32" font-weight="bold" fill="url(#goldGradient)" text-anchor="middle">Management System</text>
  <text x="385" y="280" font-family="Arial" font-size="16" fill="#F5F5F5" text-anchor="middle">Database</text>
  <text x="635" y="280" font-family="Arial" font-size="16" fill="#F5F5F5" text-anchor="middle">Dashboard</text>
</svg>
