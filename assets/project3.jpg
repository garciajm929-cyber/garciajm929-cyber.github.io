<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="800" height="400" fill="#0A0A0A"/>
  
  <!-- Gold gradient -->
  <defs>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#D4AF37;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#F4D03F;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Task board layout -->
  <rect x="60" y="60" width="200" height="280" fill="#1A1A1A" rx="8"/>
  <rect x="300" y="60" width="200" height="280" fill="#1A1A1A" rx="8"/>
  <rect x="540" y="60" width="200" height="280" fill="#1A1A1A" rx="8"/>
  
  <!-- Gold headers -->
  <rect x="60" y="60" width="200" height="50" fill="url(#gold)" rx="8" ry="8"/>
  <rect x="300" y="60" width="200" height="50" fill="url(#gold)" rx="8" ry="8"/>
  <rect x="540" y="60" width="200" height="50" fill="url(#gold)" rx="8" ry="8"/>
  
  <!-- Task cards -->
  <rect x="75" y="130" width="170" height="60" fill="#2A2A2A" rx="4"/>
  <rect x="75" y="210" width="170" height="60" fill="#2A2A2A" rx="4"/>
  <rect x="315" y="130" width="170" height="60" fill="#2A2A2A" rx="4"/>
  <rect x="555" y="130" width="170" height="60" fill="#2A2A2A" rx="4"/>
  
  <!-- Text -->
  <text x="160" y="93" font-family="Arial" font-size="18" font-weight="bold" fill="#0A0A0A" text-anchor="middle">TO DO</text>
  <text x="400" y="93" font-family="Arial" font-size="18" font-weight="bold" fill="#0A0A0A" text-anchor="middle">IN PROGRESS</text>
  <text x="640" y="93" font-family="Arial" font-size="18" font-weight="bold" fill="#0A0A0A" text-anchor="middle">DONE</text>
  <text x="400" y="35" font-family="Arial" font-size="32" font-weight="bold" fill="#D4AF37" text-anchor="middle">Task Management</text>
</svg>
