<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="800" height="400" fill="#0A0A0A"/>
  
  <!-- Gold gradient -->
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#D4AF37;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#F4D03F;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- E-commerce layout -->
  <rect x="40" y="40" width="720" height="80" fill="#1A1A1A" rx="8"/>
  <rect x="40" y="140" width="220" height="220" fill="#1A1A1A" rx="8"/>
  <rect x="280" y="140" width="220" height="220" fill="#1A1A1A" rx="8"/>
  <rect x="520" y="140" width="240" height="220" fill="#1A1A1A" rx="8"/>
  
  <!-- Gold elements -->
  <rect x="40" y="40" width="150" height="80" fill="url(#goldGrad)" rx="8"/>
  <circle cx="150" cy="250" r="40" fill="url(#goldGrad)"/>
  <circle cx="390" cy="250" r="40" fill="url(#goldGrad)"/>
  <rect x="540" y="170" width="200" height="160" fill="url(#goldGrad)" rx="4"/>
  
  <!-- Text -->
  <text x="115" y="90" font-family="Arial" font-size="28" font-weight="bold" fill="#0A0A0A" text-anchor="middle">E-Shop</text>
  <text x="400" y="100" font-family="Arial" font-size="36" font-weight="bold" fill="#D4AF37" text-anchor="middle">E-Commerce Platform</text>
  <text x="640" y="260" font-family="Arial" font-size="20" font-weight="bold" fill="#0A0A0A" text-anchor="middle">Shopping Cart</text>
</svg>
